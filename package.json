{
  "name": "dsh-terminal",
  "description": "VSCode-style integrated terminal panel for the dsh web GUI (xterm.js + node-pty)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "gui": {
      "mountId": "terminal"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Unlicense",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "node-pty": "^1.1.0",
    "react": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
